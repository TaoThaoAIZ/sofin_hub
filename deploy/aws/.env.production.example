# Mẫu .env cho server AWS (đặt tại /opt/app/.env, chmod 600). KHÔNG commit file .env thật.
# Sinh bí mật: openssl rand -hex 32   (mỗi biến một giá trị khác nhau, không bắt đầu bằng "dev-")
NODE_ENV=production
PORT=4000

# Dùng chung cho docker-compose (service postgres) và DATABASE_URL bên dưới
POSTGRES_PASSWORD=__GEN__
DATABASE_URL=postgresql://sofinhub:__SAME_AS_POSTGRES_PASSWORD__@postgres:5432/sofinhub?schema=public
RUN_MIGRATIONS=1

# URL công khai của site (có http(s)://, không dấu / cuối)
CORS_ORIGIN=http://__HOST__
FRONTEND_URL=http://__HOST__
OAUTH_REDIRECT_BASE=http://__HOST__

JWT_ACCESS_SECRET=__GEN__
JWT_REFRESH_SECRET=__GEN__
SEPAY_WEBHOOK_KEY=__GEN__
SEPAY_API_TOKEN=
BANK_ACCOUNT=
BANK_ACCOUNT_NAME=
BANK_BIN=970422
BANK_NAME=MB Bank
PAY_REF_PREFIX=SFH
# Telegram báo admin khi có thanh toán / tiền lạ (tùy chọn; trống = tắt). CHAT_ID nhiều nhóm ngăn cách dấu phẩy
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
UPLOAD_SIGNING_SECRET=__GEN__
OTP_PEPPER=__GEN__

# Email của Platform Admin, cách nhau dấu phẩy
PLATFORM_ADMIN_EMAILS=

# Upload lên S3 (credentials từ IAM role của EC2, không đặt access key)
S3_BUCKET=__BUCKET__
S3_REGION=__REGION__

# Gửi email thật (đăng ký bắt buộc OTP qua email; để trống thì production chỉ ghi log, không ai đăng ký được)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=SofinHub <no-reply@example.com>
