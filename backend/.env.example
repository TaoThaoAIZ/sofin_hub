NODE_ENV=development
PORT=4000
# Danh sách origin được phép gọi API, ngăn cách bằng dấu phẩy
CORS_ORIGIN=http://localhost:5173

# Bí mật ký JWT — BẮT BUỘC đặt giá trị riêng (vd. `openssl rand -hex 32`) khi NODE_ENV=production
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# Email của Platform Admin (đội SofinHub), ngăn cách bằng dấu phẩy — có quyền ghi đè Owner ở mọi cộng đồng
# (admin@sofinhub.test là tài khoản test do `npm run db:seed` tạo)
PLATFORM_ADMIN_EMAILS=admin@sofinhub.test

# --- Postgres (Prisma) ---
# DB docker local: `npm run db:up` (cổng 5435, đổi bằng POSTGRES_PORT ở docker-compose). Test dùng DB sofinhub_test + schema ngẫu nhiên.
DATABASE_URL=postgresql://sofinhub:sofinhub@localhost:5435/sofinhub?schema=public

# URL frontend để dựng link trong email (đặt lại mật khẩu / xác thực email)
FRONTEND_URL=http://localhost:5173
# Hộp thư nhận form liên hệ (POST /contact)
SUPPORT_EMAIL=support@sofinhub.local

# --- Upload file ---
# Thư mục lưu file (LocalDiskStorage), tương đối theo thư mục chạy backend
UPLOAD_DIR=data/uploads
# Bí mật ký vé upload PUT (HMAC) - đặt riêng khi production
UPLOAD_SIGNING_SECRET=dev-upload-secret-change-me
UPLOAD_TICKET_TTL_SEC=600
# Giới hạn dung lượng theo loại (MB) và hạn mức mỗi người dùng
UPLOAD_MAX_IMAGE_MB=5
UPLOAD_MAX_FILE_MB=2048
UPLOAD_MAX_AVATAR_MB=3
UPLOAD_MAX_COVER_MB=8
# 0 = không giới hạn dung lượng lưu trữ mỗi người
UPLOAD_USER_QUOTA_MB=0
# Số tin nhắn tối đa mỗi người / phút (0 = tắt; test luôn tắt)
MESSAGE_RATE_LIMIT_PER_MIN=20

# --- Thanh toán (Phase 8) — giá trị chính sách là TẠM, chờ chốt ---
# Bí mật ký HMAC-SHA256 cho webhook cổng thanh toán (BẮT BUỘC đổi khi production)
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret-change-me
# Số ngày dùng thử miễn phí / độ dài 1 kỳ gói (ngày)
TRIAL_DAYS=7
SUBSCRIPTION_PERIOD_DAYS=30
# Cửa sổ hoàn tiền tự động (ngày kể từ lần thanh toán đầu); ngoài cửa sổ cần Platform Admin duyệt
REFUND_WINDOW_DAYS=7
# Hoa hồng nền tảng (%) — TẠM, chờ chốt mô hình doanh thu (PLAN câu hỏi #6)
PLATFORM_COMMISSION_PCT=10
# Phí cổng thanh toán mô phỏng: % + cố định (cent)
GATEWAY_FEE_PCT=2.9
GATEWAY_FEE_FIXED_CENTS=30
# Số tiền rút tối thiểu (USD)
PAYOUT_MIN_USD=50

# --- Chatbot hỗ trợ: Codex SDK (@openai/codex-sdk) đăng nhập bằng TÀI KHOẢN CHATGPT, không dùng OpenAI API key (xem chatbot.md) ---
# Đăng nhập 1 lần: npm run chatbot:codex-login  (server không có trình duyệt: npm run chatbot:codex-login -- --device-auth)
# Chưa đăng nhập = chatbot tắt (API /api/chatbot trả 503). Bật/tắt, model, ngưỡng, link Zalo chỉnh ở Admin > Hỗ trợ > Chatbot.
# CODEX_HOME riêng của bot (chứa auth.json — KHÔNG commit, đã nằm trong .gitignore/.dockerignore)
CHATBOT_CODEX_HOME=data/codex-home
# Số lượt Codex chạy song song / thời gian tối đa mỗi lượt (ms)
# Giữ <= 3 với tài khoản ChatGPT cá nhân (tải tự động cao: rủi ro hạn mức / điều khoản). Chung cho bot Tào + mọi bot cộng đồng.
CHATBOT_MAX_CONCURRENCY=3
CHATBOT_TIMEOUT_MS=90000
# Chờ tối đa trong hàng đợi (ms) trước khi báo "đang bận"
CHATBOT_QUEUE_WAIT_MS=60000
# =1: model giả, không gọi ChatGPT (chỉ dev/test/E2E; production bị chặn)
# CHATBOT_FAKE_MODEL=1
