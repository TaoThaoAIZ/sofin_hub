// Schema Postgres của SofinHub. Tài liệu: backend/docs/DATABASE.md
//
// Quy ước chung
//  - id: String @default(uuid()); riêng Course.id là slug chuỗi tự do ('photo', 'yt'...) và Invite.code, Certificate.code,
//    Upload.key là khóa nghiệp vụ.
//  - Tiền: Int theo cent (`*Cents`). Không dùng Float/Decimal cho tiền.
//  - Thời điểm: DateTime (timestamptz-like UTC). Domain hiện dùng ISO string -> map bằng toISOString().
//  - Nội dung linh hoạt (poll, attachments, preferences) là Json.
//  - Xóa user = xóa CASCADE toàn bộ dữ liệu của user (xem DATABASE.md, mục "Quyết định").

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  importFileExtension    = "js"
  generatedFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// ENUMS
// ============================================================================

enum CourseCategory {
  business
  content
  tech
  finance
  health
  self
  hobby
  relationships
  /// Thêm bởi Admin đợt 2 (danh mục Discovery): chỉ dùng được sau khi admin tạo trong DiscoveryCategory.
  marketing
  design
  /// Wizard tạo cộng đồng: danh mục theo mockup.
  music
  sports
  spirituality
}

enum CourseTag {
  hot
  bestseller
  new
}

enum Pricing {
  free
  paid
  trial
}

enum Visibility {
  public
  private
}

enum CourseStatus {
  open
  soon
  completed
}

enum Language {
  vi
  en
}

enum MemberRole {
  member
  mod
  admin
  owner
}

enum JoinRequestStatus {
  pending
  approved
  rejected
}

// Giá trị trong DB là chuỗi tiếng Việt hiển thị (map), tên enum trong code là mã ASCII.
// Đổi qua lại bằng src/db/enums.ts (postCategoryToDomain / postCategoryFromDomain).
enum PostCategory {
  general      @map("Thảo luận chung")
  qa           @map("Hỏi đáp")
  case_study   @map("Case study")
  announcement @map("Thông báo")
}

enum PointReason {
  post
  like_received
  lesson_complete
  event_rsvp
  /// Điểm âm bù khi xóa bài/sự kiện đã sinh điểm (cùng transaction với việc xóa).
  revoked
}

enum LessonType {
  video
  text
  file
}

enum NotificationType {
  post_liked
  post_commented
  event_created
  event_reminder
  member_joined
  role_changed
  removed_from_community
  payment_succeeded
  payment_failed
  report_resolved
  message_received
  system
}

enum EmailDigest {
  off
  /// Gửi email ngay khi có thông báo.
  instant
  daily
  weekly
}

enum ReportReason {
  spam
  harassment
  inappropriate
  misinformation
  other
  hate_speech
  scam
  copyright
  nsfw
}

enum ReportTargetType {
  post
  comment
  member
}

enum ReportStatus {
  open
  resolved
  dismissed
  under_review
}

enum ReportAction {
  dismiss
  hide_content
  ban_member
  warn_user
  remove_content
  restrict_user
  suspend_user
  ban_user
  none
}

enum ReportRisk {
  low
  medium
  high
  critical
}

/// Trạng thái tài khoản do Platform Admin đặt (đợt 1 admin). restricted = chỉ đọc; suspended/banned = không đăng nhập được.
enum UserStatus {
  active
  restricted
  suspended
  banned
}

/// Trạng thái kiểm duyệt cộng đồng (tách khỏi Course.status = open/soon/completed).
enum CommunityModeration {
  /// Bản nháp của wizard tạo cộng đồng: chỉ chủ thấy, không hiện công khai/Khám phá/tìm kiếm.
  draft
  pending_review
  changes_requested
  rejected
  active
  suspended
  deleted
}

/// Chu kỳ thanh toán của gói thành viên (và của gói hosting owner).
enum BillingInterval {
  monthly
  annual
}

enum HostingPlanKey {
  start
  pro
}

enum HostingPlanStatus {
  trialing
  active
  canceled
}

enum PayoutAccountStatus {
  connected
  skipped
}

enum PaymentMethod {
  stripe
  vnpay
  momo
  /// Chuyển khoản ngân hàng qua VietQR + SePay (luồng thanh toán duy nhất của thành viên/mua module).
  bank_transfer
}

enum PaymentStatus {
  pending
  succeeded
  failed
  refunded
}

enum PaymentKind {
  initial
  renewal
  /// Mua lẻ MỘT module trả phí (một lần, không phải gói thành viên). `Payment.moduleId` trỏ module được mua.
  module
}

enum SubscriptionStatus {
  trialing
  active
  canceled
  expired
  /// Admin đợt 2: quá hạn thanh toán / tạm dừng bởi admin.
  past_due
  paused
}

enum RefundStatus {
  pending
  /// Đang hoàn tiền: đã khóa yêu cầu + gọi cổng (ngoài transaction). Kẹt ở đây ⇒ job đối soát `reconcileStuckRefunds`.
  refunding
  approved
  rejected
}

/// Sổ nợ/điều chỉnh số dư Owner (append-only). amountCents < 0 = nợ phát sinh (vd. hoàn tiền sau khi đã chi payout).
enum OwnerLedgerKind {
  refund_after_payout
  chargeback_after_payout
  adjustment
}

enum PayoutStatus {
  requested
  approved
  paid
  rejected
  /// Admin đợt 2.
  failed
  on_hold
}

/// Admin đợt 2: xuất bản của khóa học (ClassroomModule).
enum ContentPublishStatus {
  published
  draft
  archived
}

/// Ai được mở module: all = mọi thành viên; level = đủ cấp độ; paid = đã mua/được cấp; selected = chỉ người được chọn.
enum ModuleAccessMode {
  all
  level
  paid
  selected
}

enum ModuleAccessSource {
  selected
  purchase
}

enum DiscoveryStatus {
  listed
  hidden
  unlisted
}

enum SearchVisibility {
  searchable
  reduced
  hidden
}

enum ChargebackStatus {
  open
  under_review
  won
  lost
}

enum ChargebackReason {
  fraudulent
  product_not_received
  duplicate
  subscription_cancelled
  unrecognized
  product_not_as_described
}

enum UploadPurpose {
  post_image
  post_file
  avatar
  cover
  lesson_attachment
  message_attachment
}

enum UploadStatus {
  pending
  uploaded
}

// Domain dùng 'reset-password' / 'verify-email' (gạch ngang) -> đổi ở lớp repository.
enum OneTimeTokenPurpose {
  reset_password
  verify_email
}

// ============================================================================
// AUTH
// ============================================================================

model User {
  id                 String     @id @default(uuid())
  /// Luôn lưu chữ thường (service chuẩn hóa trước khi ghi).
  email              String     @unique
  firstName          String
  lastName           String
  passwordHash       String
  bio                String?
  location           String?
  website            String?
  avatarUrl          String?
  /// Ảnh bìa hồ sơ công khai (URL http/https hoặc /api/files/...).
  coverUrl           String?
  /// Đường dẫn hồ sơ sofinhub.com/@handle: [a-z0-9._]{3,24}, duy nhất, null = chưa đặt.
  handle             String?    @unique
  instagram          String?
  youtube            String?
  /// Hiện vị trí trên bản đồ thành viên.
  showOnMap          Boolean    @default(true)
  /// vi | en
  language           String     @default("vi")
  /// IANA, ví dụ Asia/Ho_Chi_Minh.
  timezone           String     @default("Asia/Ho_Chi_Minh")
  /// light | dark | system
  theme              String     @default("light")
  /// Bí mật TOTP (base32) — chỉ có khi đang thiết lập hoặc đã bật 2FA.
  totpSecret         String?
  twoFactorEnabled   Boolean    @default(false)
  passwordChangedAt  DateTime?
  /// Email mới đang chờ xác minh (đổi email).
  pendingEmail       String?
  emailVerified      Boolean    @default(false)
  /// Tăng khi đổi mật khẩu / xóa tài khoản: access token mang tokenVersion cũ bị từ chối.
  tokenVersion       Int        @default(0)
  /// Thành viên minh họa (thay cho id "seed:..."): mật khẩu không đăng nhập được.
  isDemo             Boolean    @default(false)
  /// Tài khoản đã xóa = ẩn danh hóa (giữ hàng để bài viết/điểm/thanh toán còn tham chiếu được).
  deletedAt          DateTime?
  /// Trạng thái do Platform Admin đặt; statusUntil = hạn (null = vô thời hạn); statusRestrictions = các quyền bị chặn khi restricted
  /// (post|comment|dm|create_community|purchase).
  status             UserStatus @default(active)
  statusReason       String?
  statusUntil        DateTime?
  statusRestrictions String[]   @default([])
  statusChangedAt    DateTime?
  /// Admin đặt trạng thái (không FK để không ràng buộc khi admin bị xóa).
  statusChangedById  String?
  lastLoginAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  sessions            Session[]
  referralCode        ReferralCode?            @relation("ReferralCodeOwner")
  referralsMade       Referral[]               @relation("ReferralReferrer")
  referredBy          Referral?                @relation("ReferralReferred")
  commissionsEarned   ReferralCommission[]     @relation("CommissionReferrer")
  commissionsCaused   ReferralCommission[]     @relation("CommissionReferred")
  oneTimeTokens       OneTimeToken[]
  emailOtps           EmailOtp[]
  socialAccounts      SocialAccount[]
  ownedCommunities    Community[]              @relation("CourseOwner")
  enrollments         Enrollment[]
  bansReceived        CommunityBan[]           @relation("BanTarget")
  bansIssued          CommunityBan[]           @relation("BanIssuer")
  joinRequests        JoinRequest[]            @relation("JoinRequester")
  joinRequestsDecided JoinRequest[]            @relation("JoinDecider")
  invitesCreated      Invite[]
  reviews             Review[]
  posts               Post[]
  comments            PostComment[]
  likes               PostLike[]
  likeNotices         PostLikeNotice[]
  pollVotes           PollVote[]
  hostedEvents        CommunityEvent[]
  eventRsvps          EventRsvp[]
  pointEvents         PointEvent[]
  lessonProgress      LessonProgress[]
  moduleAccess        ModuleAccess[]
  certificates        Certificate[]
  notifications       Notification[]
  notificationPrefs   NotificationPreference?
  conversationsAsA    Conversation[]           @relation("ConversationUserA")
  conversationsAsB    Conversation[]           @relation("ConversationUserB")
  messagesSent        Message[]
  blocksMade          UserBlock[]              @relation("Blocker")
  blocksReceived      UserBlock[]              @relation("BlockTarget")
  reportsFiled        Report[]                 @relation("ReportReporter")
  reportsAgainst      Report[]                 @relation("ReportTargetUser")
  reportsResolved     Report[]                 @relation("ReportResolver")
  reportsAssigned     Report[]                 @relation("ReportAssignee")
  reportEvents        ReportEvent[]
  auditLogs           AdminAuditLog[]          @relation("AuditActor")
  payments            Payment[]
  paymentCards        PaymentCard[]
  payoutAccountsOwned PayoutAccount[]
  subscriptions       Subscription[]
  refundRequests      RefundRequest[]          @relation("RefundRequester")
  refundsResolved     RefundRequest[]          @relation("RefundResolver")
  payouts             Payout[]
  chargebacks         Chargeback[]
  idempotencyKeys     IdempotencyKey[]
  uploads             Upload[]
  ticketsRequested    SupportTicket[]          @relation("TicketRequester")
  ticketsAssigned     SupportTicket[]          @relation("TicketAssignee")
  adminAccount        AdminAccount?            @relation("AdminAccountUser")
  /// Cột GENERATED ALWAYS (họ tên đã gập dấu).
  searchVector        Unsupported("tsvector")?

  @@index([isDemo])
  @@index([status])
  @@index([searchVector], type: Gin)
}

/// Phiên đăng nhập = 1 chuỗi refresh token xoay vòng (rotation). id chính là `sid` trong JWT refresh.
model Session {
  id               String    @id @default(uuid())
  userId           String
  /// sha256 của jti refresh token HIỆN HÀNH; null = token vừa bị dùng, chưa cấp token kế tiếp.
  refreshTokenHash String?
  ip               String?
  userAgent        String?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())
  revokedAt        DateTime?
  expiresAt        DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

/// Mã OTP 6 số gửi qua email (đăng ký). Chỉ lưu HMAC của mã; mỗi (user, mục đích) chỉ 1 mã còn hiệu lực. Sai quá `attempts` cho phép thì mã bị hủy.
model EmailOtp {
  id              String   @id @default(uuid())
  userId          String
  /// register
  purpose         String
  codeHash        String
  expiresAt       DateTime
  attempts        Int      @default(0)
  lastSentAt      DateTime @default(now())
  sendCount       Int      @default(1)
  sendWindowStart DateTime @default(now())
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, purpose])
}

/// Liên kết tài khoản với nhà cung cấp đăng nhập mạng xã hội (google | facebook).
model SocialAccount {
  id             String   @id @default(uuid())
  userId         String
  provider       String
  /// Id người dùng phía nhà cung cấp (Google `sub`, Facebook `id`).
  providerUserId String
  email          String?
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
}

/// Token dùng 1 lần (đặt lại mật khẩu / xác thực email). Chỉ lưu sha256 của token. Mỗi (user, mục đích) chỉ 1 token còn hiệu lực.
model OneTimeToken {
  id        String              @id @default(uuid())
  userId    String
  purpose   OneTimeTokenPurpose
  tokenHash String              @unique
  expiresAt DateTime
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, purpose])
}

// ============================================================================
// KHÓA HỌC / CỘNG ĐỒNG
// ============================================================================

/// Cộng đồng/khóa học. `id` là slug chuỗi ('photo'), do seed hoặc service sinh.
model Community {
  id                    String               @id
  title                 String
  description           String
  category              CourseCategory
  tag                   CourseTag?
  thumbnail             String
  instructorName        String
  instructorRole        String
  /// Số bài học khai báo (dùng sinh lớp học mẫu). Số bài thật nằm ở ClassroomLesson.
  lessons               Int                  @default(0)
  durationMinutes       Int                  @default(0)
  /// Số liệu nền của seed (học viên/đánh giá) để trang chủ không trống; đánh giá thật trộn thêm từ Review.
  students              Int                  @default(0)
  rating                Float                @default(0)
  ratingCount           Int                  @default(0)
  /// Giá theo tháng, cent (domain `priceUsd` = priceCents / 100).
  priceCents            Int                  @default(0)
  /// Giá theo năm (cent), null = không bán gói năm. Phải <= 12 x priceCents.
  priceAnnualCents      Int?
  /// Wizard tạo cộng đồng: nhận diện & giới thiệu.
  logoUrl               String?
  coverUrl              String?
  brandColor            String?
  promise               String?
  benefits              String[]             @default([])
  introVideoUrl         String?
  /// Nội quy có thứ tự: [{ title, body }].
  rules                 Json                 @default("[]")
  /// Câu hỏi khi xin gia nhập (tối đa 3).
  joinQuestions         String[]             @default([])
  memberTrialEnabled    Boolean              @default(true)
  requireRulesAgreement Boolean              @default(false)
  autoApprovePaid       Boolean              @default(false)
  /// Các bước wizard đã lưu (basics|plan|identity|members) khi còn là bản nháp.
  draftSteps            String[]             @default([])
  pricing               Pricing              @default(paid)
  visibility            Visibility           @default(public)
  status                CourseStatus         @default(open)
  language              Language             @default(vi)
  /// Thứ hạng "trending" của seed (nhỏ = đứng trước); null = cộng đồng người dùng tạo.
  trendingRank          Int?
  /// null = cộng đồng seed mẫu (chưa có chủ).
  ownerId               String?
  /// Bị Platform Admin khóa.
  locked                Boolean              @default(false)
  lockReason            String?
  /// Xóa mềm.
  deletedAt             DateTime?
  /// Kiểm duyệt của Platform Admin (đợt 1 admin). Cộng đồng seed/hiện có = active. Chỉ `active` mới hiện ở danh sách công khai.
  moderationStatus      CommunityModeration  @default(active)
  moderationReason      String?
  moderationNote        String?
  moderationUntil       DateTime?
  moderationUpdatedAt   DateTime?
  moderatedById         String?
  /// Trạng thái trước khi xóa (để undelete trả về đúng); lý do/người xóa (null = chủ tự xóa).
  preDeleteStatus       CommunityModeration?
  deleteReason          String?
  deletedById           String?
  /// Discovery (Admin đợt 2): chỉ `listed` mới hiện ở danh sách công khai; searchVisibility điều khiển tìm kiếm.
  discoveryStatus       DiscoveryStatus      @default(listed)
  searchVisibility      SearchVisibility     @default(searchable)
  discoveryReason       String?
  discoveryUpdatedAt    DateTime?
  discoveryUpdatedById  String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  owner User? @relation("CourseOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  enrollments       Enrollment[]
  bans              CommunityBan[]
  joinRequests      JoinRequest[]
  invites           Invite[]
  reviews           Review[]
  posts             Post[]
  events            CommunityEvent[]
  pointEvents       PointEvent[]
  learningCourses   Course[]
  modules           ClassroomModule[]
  lessonsList       ClassroomLesson[]
  classroomSettings ClassroomSettings?
  certificates      Certificate[]
  notifications     Notification[]
  reports           Report[]
  payments          Payment[]
  subscriptions     Subscription[]
  refundRequests    RefundRequest[]
  payouts           Payout[]
  uploads           Upload[]
  chargebacks       Chargeback[]
  discoveryFeatures DiscoveryFeature[]
  ownerLedger       OwnerBalanceLedger[]
  hostingPlan       HostingPlan?
  payoutAccount     PayoutAccount?
  /// Cột GENERATED ALWAYS (title A + description B, đã gập dấu).
  searchVector      Unsupported("tsvector")?

  @@index([category])
  @@index([ownerId])
  @@index([deletedAt, locked])
  @@index([moderationStatus])
  @@index([createdAt])
  @@index([searchVector], type: Gin)
  /// Bảng DB giữ tên cũ "Course" (đổi tên domain, không di chuyển dữ liệu).
  @@map("Course")
}

/// Thành viên của cộng đồng (khóa chính ghép user+course). Bị ban -> có dòng CommunityBan, KHÔNG còn được coi là đã tham gia.
model Enrollment {
  userId         String
  communityId    String     @map("courseId")
  role           MemberRole @default(member)
  enrolledAt     DateTime   @default(now())
  lastActiveAt   DateTime   @default(now())
  /// Tùy chọn cá nhân ở Cài đặt > Cộng đồng của tôi.
  sidebarVisible Boolean    @default(true)
  pinned         Boolean    @default(false)
  sortOrder      Int?
  updatedAt      DateTime   @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@id([userId, communityId])
  @@index([communityId, role])
}

/// Bản ghi cấm. Tồn tại (courseId,userId) = đang bị cấm (thay cho set `banned` + `BanRecord` trong bộ nhớ).
model CommunityBan {
  communityId String   @map("courseId")
  userId      String
  reason      String   @default("")
  bannedById  String?
  bannedAt    DateTime @default(now())

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user      User      @relation("BanTarget", fields: [userId], references: [id], onDelete: Cascade)
  bannedBy  User?     @relation("BanIssuer", fields: [bannedById], references: [id], onDelete: SetNull)

  @@id([communityId, userId])
  @@index([userId])
  @@index([bannedById])
}

/// Yêu cầu tham gia cộng đồng riêng tư. Ràng buộc "mỗi user chỉ 1 yêu cầu pending / cộng đồng" do service kiểm tra.
model JoinRequest {
  id              String            @id @default(uuid())
  communityId     String            @map("courseId")
  userId          String
  message         String            @default("")
  /// Bản chụp câu hỏi + câu trả lời lúc gửi yêu cầu: [{ question, answer }].
  answers         Json              @default("[]")
  rulesAcceptedAt DateTime?
  status          JoinRequestStatus @default(pending)
  decidedById     String?
  decidedAt       DateTime?
  createdAt       DateTime          @default(now())

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user      User      @relation("JoinRequester", fields: [userId], references: [id], onDelete: Cascade)
  decidedBy User?     @relation("JoinDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([communityId, status, createdAt])
  @@index([userId, communityId])
  @@index([decidedById])
}

model Invite {
  code        String    @id
  communityId String    @map("courseId")
  createdById String
  /// null = không giới hạn.
  maxUses     Int?
  usedCount   Int       @default(0)
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([communityId, createdAt])
  @@index([createdById])
}

model Review {
  id          String   @id @default(uuid())
  communityId String   @map("courseId")
  userId      String
  rating      Int
  text        String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@index([communityId, updatedAt])
  @@index([userId])
}

// ============================================================================
// BẢNG TIN
// ============================================================================

model Post {
  id            String       @id @default(uuid())
  communityId   String       @map("courseId")
  authorId      String
  content       String
  category      PostCategory @default(general)
  imageUrl      String?
  tags          String[]     @default([])
  pinned        Boolean      @default(false)
  /// Bị mod ẩn.
  hidden        Boolean      @default(false)
  /// Đếm phi chuẩn hóa (cập nhật trong cùng transaction với like/comment).
  likesCount    Int          @default(0)
  commentsCount Int          @default(0)
  /// PollDef: { question?, options: [{id,text}], multiple, closesAt? }. null = không có bình chọn.
  poll          Json?
  /// Gỡ bởi Platform Admin (Admin đợt 2). hidden=true kèm removedAt = trạng thái removed.
  removedAt     DateTime?
  modReason     String?
  modAt         DateTime?
  modById       String?
  createdAt     DateTime     @default(now())
  editedAt      DateTime?
  updatedAt     DateTime     @updatedAt

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  comments     PostComment[]
  likes        PostLike[]
  likeNotices  PostLikeNotice[]
  pollVotes    PollVote[]
  /// Cột GENERATED ALWAYS (migration 20261005100000_search_fulltext): chỉ đọc bằng SQL thô; Prisma bỏ qua khi ghi.
  searchVector Unsupported("tsvector")?

  @@index([communityId, pinned, createdAt])
  @@index([authorId])
  @@index([communityId, pinned, likesCount, createdAt])
  @@index([communityId, category, createdAt])
  @@index([searchVector], type: Gin)
}

model PostComment {
  id        String    @id @default(uuid())
  postId    String
  authorId  String
  content   String
  hidden    Boolean   @default(false)
  removedAt DateTime?
  modReason String?
  modAt     DateTime?
  modById   String?
  createdAt DateTime  @default(now())
  editedAt  DateTime?
  updatedAt DateTime  @updatedAt

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([authorId])
}

model PostLike {
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId])
}

/// Đã gửi thông báo "được thích" cho cặp (bài, user) — giữ lại dù user bỏ thích, để không thông báo lặp.
model PostLikeNotice {
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId])
}

/// Phiếu bình chọn: 1 dòng cho mỗi (bài, user, đáp án). optionId trỏ tới options[].id trong Post.poll.
model PollVote {
  postId    String
  userId    String
  optionId  String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId, optionId])
  @@index([postId, optionId])
  @@index([userId])
}

// ============================================================================
// SỰ KIỆN
// ============================================================================

model CommunityEvent {
  id           String    @id @default(uuid())
  communityId  String    @map("courseId")
  hostId       String
  title        String
  description  String    @default("")
  startAt      DateTime
  timezone     String
  meetingLink  String?
  capacity     Int?
  /// Admin đợt 2: hủy (vẫn hiển thị, không RSVP được) / gỡ (ẩn khỏi API công khai).
  cancelledAt  DateTime?
  cancelReason String?
  removedAt    DateTime?
  modReason    String?
  modAt        DateTime?
  modById      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  host      User      @relation(fields: [hostId], references: [id], onDelete: Cascade)

  rsvps EventRsvp[]

  @@index([communityId, startAt])
  @@index([startAt])
  @@index([hostId])
}

model EventRsvp {
  eventId    String
  userId     String
  createdAt  DateTime  @default(now())
  /// Đã gửi nhắc lịch (thay cho set `reminded`); clearReminded = đặt null cho mọi RSVP của sự kiện.
  remindedAt DateTime?

  event CommunityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@index([userId])
}

// ============================================================================
// ĐIỂM
// ============================================================================

/// Sổ cái điểm (append-only). Bảng xếp hạng = SUM theo cửa sổ thời gian.
model PointEvent {
  id          String      @id @default(uuid())
  userId      String
  communityId String      @map("courseId")
  points      Int
  reason      PointReason
  /// Khóa nghiệp vụ chống cộng điểm lặp: (user, reason, sourceType, sourceId). Dòng cũ (trước migration) có thể null.
  /// post: sourceType='post', sourceId=postId · like_received: 'post_like', `${postId}:${likerId}` · lesson_complete: 'lesson', lessonId
  /// event_rsvp: 'event', eventId · revoked (bù trừ): 'post'|'event', id nguồn.
  sourceType  String?
  sourceId    String?
  createdAt   DateTime    @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([userId, reason, sourceType, sourceId])
  @@index([communityId, createdAt])
  @@index([userId, communityId])
  @@index([sourceType, sourceId])
}

// ============================================================================
// LỚP HỌC
// ============================================================================

/// Khóa học (Khóa học) — một cộng đồng có NHIỀU khóa học; mỗi khóa chứa nhiều module/bài. Bảng "LearningCourse"
/// (tên Prisma `Course` vì đây là "khóa học" theo BRD; cộng đồng là `Community` map bảng "Course").
model Course {
  id                  String               @id @default(uuid())
  communityId         String
  title               String
  description         String               @default("")
  thumbnailUrl        String?
  /// Thứ tự hiển thị 1..n trong cộng đồng (service đánh lại khi thêm/xóa/sắp xếp).
  position            Int
  /// Xuất bản (cùng ngữ nghĩa ClassroomModule đợt 2). Thành viên thường chỉ thấy published; mod+ thấy cả nháp/lưu trữ.
  publishStatus       ContentPublishStatus @default(published)
  /// Ghi đè cờ ClassroomSettings.certificatesEnabled của cộng đồng; null = kế thừa.
  certificatesEnabled Boolean?
  /// Admin đợt 2: gỡ bởi Platform Admin.
  removedAt           DateTime?
  modReason           String?
  modAt               DateTime?
  modById             String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  community    Community         @relation(fields: [communityId], references: [id], onDelete: Cascade)
  modules      ClassroomModule[]
  certificates Certificate[]

  @@index([communityId, position])
  @@map("LearningCourse")
}

model ClassroomModule {
  id               String               @id @default(uuid())
  communityId      String               @map("courseId")
  /// Khóa học (entity `Course`, bảng LearningCourse) chứa module. Cột DB `learningCourseId` (cột `courseId` cũ = id cộng đồng, field `communityId`).
  learningCourseId String
  /// Thứ tự hiển thị 1..n trong khóa (service đánh lại khi thêm/xóa/sắp xếp; không đặt unique để đổi chỗ trong 1 transaction).
  index            Int
  title            String
  description      String               @default("")
  thumbnail        String?
  /// Cấp độ (1..9) tối thiểu để mở khóa; null = không yêu cầu.
  requiredLevel    Int?
  /// Chế độ truy cập (all/level/paid/selected). `requiredLevel` chỉ có nghĩa khi accessMode = level.
  accessMode       ModuleAccessMode     @default(all)
  /// Giá (đơn vị cent) khi accessMode = paid.
  priceCents       Int?
  /// Bài trong module phải hoàn thành lần lượt.
  sequential       Boolean              @default(false)
  /// Admin đợt 2: xuất bản + gỡ. Thành viên chỉ thấy module published và chưa bị gỡ.
  publishStatus    ContentPublishStatus @default(published)
  removedAt        DateTime?
  modReason        String?
  modAt            DateTime?
  modById          String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  community Community         @relation(fields: [communityId], references: [id], onDelete: Cascade)
  course    Course            @relation(fields: [learningCourseId], references: [id], onDelete: Cascade)
  lessons   ClassroomLesson[]
  access    ModuleAccess[]
  payments  Payment[]

  @@index([communityId, index])
  @@index([learningCourseId, index])
}

model ClassroomLesson {
  id          String     @id @default(uuid())
  moduleId    String
  /// Phi chuẩn hóa để truy vấn theo khóa nhanh (luôn bằng module.courseId).
  communityId String     @map("courseId")
  index       Int
  title       String
  type        LessonType @default(video)
  durationMin Int        @default(0)
  body        String     @default("")
  videoUrl    String?
  embedUrl    String?
  /// [{ name, url, size? }]
  attachments Json       @default("[]")
  /// Admin đợt 2: ẩn / gỡ khỏi thành viên.
  hidden      Boolean    @default(false)
  /// Bài xem thử miễn phí: mở được kể cả khi module bị khóa theo quyền truy cập.
  isPreview   Boolean    @default(false)
  removedAt   DateTime?
  modReason   String?
  modAt       DateTime?
  modById     String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  module    ClassroomModule  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  community Community        @relation(fields: [communityId], references: [id], onDelete: Cascade)
  progress  LessonProgress[]

  @@index([moduleId, index])
  @@index([communityId])
}

/// Quyền mở 1 module cho 1 user (accessMode = selected | paid).
model ModuleAccess {
  moduleId  String
  userId    String
  source    ModuleAccessSource @default(selected)
  createdAt DateTime           @default(now())

  module ClassroomModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([moduleId, userId])
  @@index([userId])
}

/// Tiến độ học. Có dòng = ĐÃ TỪNG hoàn thành (để chỉ cộng điểm 1 lần); completedAt=null nghĩa là đã bỏ đánh dấu.
model LessonProgress {
  userId           String
  lessonId         String
  completedAt      DateTime?
  firstCompletedAt DateTime  @default(now())

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson ClassroomLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([userId, lessonId])
  @@index([lessonId])
}

model ClassroomSettings {
  communityId         String  @id @map("courseId")
  certificatesEnabled Boolean @default(false)

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
}

model Certificate {
  /// Mã xác minh công khai.
  code             String   @id
  userId           String
  communityId      String   @map("courseId")
  /// Khóa học được chứng nhận.
  learningCourseId String
  holderName       String
  courseTitle      String
  completedAt      DateTime
  issuedAt         DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  course    Course    @relation(fields: [learningCourseId], references: [id], onDelete: Cascade)

  @@unique([userId, learningCourseId])
  @@index([communityId])
  @@index([learningCourseId])
}

// ============================================================================
// THÔNG BÁO
// ============================================================================

model Notification {
  id          String           @id @default(uuid())
  userId      String
  type        NotificationType
  title       String
  body        String
  /// Đường dẫn FE, vd. `/courses/photo/community`.
  link        String?
  communityId String?          @map("courseId")
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  community Community? @relation(fields: [communityId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([communityId])
}

model NotificationPreference {
  userId              String      @id
  /// Record<NotificationType, boolean>
  types               Json        @default("{}")
  emailDigest         EmailDigest @default(off)
  /// Giờ im lặng (HH:mm theo múi giờ của user).
  quietEnabled        Boolean     @default(false)
  quietFrom           String      @default("22:00")
  quietTo             String      @default("07:00")
  /// Cho phép người khác nhắn tin riêng.
  dmAllowed           Boolean     @default(true)
  emailUnreadDm       Boolean     @default(true)
  notifyFollowedPosts Boolean     @default(true)
  /// Record<communityId, { admin, event, featured, comment, joinRequest: boolean }>; thiếu = mặc định bật.
  communityPrefs      Json        @default("{}")
  updatedAt           DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================================
// TIN NHẮN
// ============================================================================

/// Cuộc trò chuyện 1-1. userAId < userBId (so sánh chuỗi) — có CHECK trong migration — nên cặp nào cũng ra đúng 1 dòng.
model Conversation {
  id            String   @id @default(uuid())
  userAId       String
  userBId       String
  createdAt     DateTime @default(now())
  lastMessageAt DateTime @default(now())
  /// Message.seq đã đọc gần nhất của từng phía.
  readSeqA      Int      @default(0)
  readSeqB      Int      @default(0)
  /// "Xóa cuộc trò chuyện" chỉ phía mình: tin có seq <= giá trị này bị ẩn với từng phía (tin mới hơn vẫn hiện).
  clearedSeqA   Int      @default(0)
  clearedSeqB   Int      @default(0)

  userA User @relation("ConversationUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("ConversationUserB", fields: [userBId], references: [id], onDelete: Cascade)

  messages Message[]

  @@unique([userAId, userBId])
  @@index([userBId])
  @@index([lastMessageAt])
}

model Message {
  id             String    @id @default(uuid())
  /// Số thứ tự tăng dần TOÀN CỤC (cursor phân trang + tính chưa đọc).
  seq            Int       @unique @default(autoincrement())
  conversationId String
  senderId       String
  content        String
  /// [{ url, name, contentType, size }]
  attachments    Json      @default("[]")
  createdAt      DateTime  @default(now())
  /// Thu hồi: content='' , attachments=[].
  deletedAt      DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, seq])
  @@index([senderId])
}

model UserBlock {
  blockerId String
  targetId  String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  target  User @relation("BlockTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@id([blockerId, targetId])
  @@index([targetId])
}

// ============================================================================
// KIỂM DUYỆT
// ============================================================================

model Report {
  id            String           @id @default(uuid())
  communityId   String           @map("courseId")
  targetType    ReportTargetType
  /// postId | commentId | userId tùy targetType (không FK vì nội dung có thể bị xóa; đã có targetExcerpt).
  targetId      String
  targetUserId  String
  targetExcerpt String?
  reporterId    String
  reason        ReportReason
  detail        String?
  status        ReportStatus     @default(open)
  action        ReportAction?
  note          String?
  resolvedById  String?
  resolvedAt    DateTime?
  createdAt     DateTime         @default(now())
  /// Mã hiển thị CASE-00012 (số tăng dần).
  caseNo        Int              @unique @default(autoincrement())
  risk          ReportRisk       @default(low)
  assignedToId  String?
  escalatedAt   DateTime?

  events     ReportEvent[]
  assignedTo User?         @relation("ReportAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  community  Community     @relation(fields: [communityId], references: [id], onDelete: Cascade)
  reporter   User          @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetUser User          @relation("ReportTargetUser", fields: [targetUserId], references: [id], onDelete: Cascade)
  resolvedBy User?         @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([reporterId, targetType, targetId])
  @@index([communityId, status, createdAt])
  @@index([status, risk, createdAt])
  @@index([targetUserId])
  @@index([targetType, targetId])
  @@index([resolvedById])
  @@index([assignedToId])
}

/// Lịch sử xử lý 1 case (giao việc, cảnh cáo, gỡ nội dung...). Append-only.
model ReportEvent {
  id        String   @id @default(uuid())
  reportId  String
  actorId   String?
  /// assign | warn | remove_content | restrict_user | suspend_user | ban_user | dismiss | escalate | resolve
  type      String
  note      String?
  meta      Json?
  createdAt DateTime @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([reportId, createdAt])
  @@index([actorId])
}

/// Nhật ký hành động của Platform Admin (append-only). actorName/targetLabel là ảnh chụp tại thời điểm làm.
model AdminAuditLog {
  id          String   @id @default(uuid())
  actorId     String?
  actorName   String
  /// vd. user.ban, community.approve, case.warn
  action      String
  /// community | user | case | content | payment | refund | payout | report
  targetType  String
  targetId    String
  targetLabel String   @default("")
  reason      String?
  note        String?
  evidence    String?
  caseId      String?
  metadata    Json?
  ip          String?
  createdAt   DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([action, createdAt])
}

// ============================================================================
// THANH TOÁN
// ============================================================================

/// Domain `PaymentIntent`. Tiền: amountCents / refundedCents (Int). `amountUsd` = amountCents / 100.
model Payment {
  id              String          @id @default(uuid())
  communityId     String          @map("courseId")
  userId          String
  method          PaymentMethod
  amountCents     Int
  currency        String          @default("vnd")
  trialDays       Int             @default(0)
  interval        BillingInterval @default(monthly)
  /// Thẻ (chỉ brand/last4/hạn + token cổng) dùng cho giao dịch này.
  paymentCardId   String?
  status          PaymentStatus   @default(pending)
  kind            PaymentKind     @default(initial)
  subscriptionId  String?
  /// Chỉ có khi kind = module: module được mua lẻ (cấp ModuleAccess source 'purchase' khi thanh toán thành công, thu hồi khi hoàn tiền).
  moduleId        String?
  /// INV-YYYY-NNNNNN (cấp từ InvoiceSequence khi thanh toán thành công).
  invoiceNumber   String?         @unique
  gatewayChargeId String?
  /// Mã tham chiếu khách ghi vào nội dung chuyển khoản (VD SFH7K2P9Q4). Unique; khớp tiền vào ⇄ giao dịch.
  refCode         String?         @unique
  /// Hết hạn phiên chuyển khoản (pending quá hạn ⇒ failed/expired). Gia hạn: tới hết kỳ ân hạn.
  expiresAt       DateTime?
  refundedCents   Int             @default(0)
  /// Lý do thất bại (cổng trả về / seed).
  failureReason   String?
  periodStart     DateTime?
  periodEnd       DateTime?
  confirmedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  community    Community        @relation(fields: [communityId], references: [id], onDelete: Restrict)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription?    @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  paymentCard  PaymentCard?     @relation(fields: [paymentCardId], references: [id], onDelete: SetNull)
  module       ClassroomModule? @relation(fields: [moduleId], references: [id], onDelete: SetNull)

  refunds     RefundRequest[]
  chargebacks Chargeback[]

  @@index([userId, createdAt])
  @@index([communityId, createdAt])
  @@index([subscriptionId])
  @@index([paymentCardId])
  @@index([moduleId])
  @@index([status])
}

/// Gói thành viên. active + cancelAtPeriodEnd=true = "đã hủy, còn truy cập tới hết kỳ".
/// Ràng buộc KHÔNG khai báo được trong Prisma (index riêng trong migration money_lifecycle):
///   CREATE UNIQUE INDEX "Subscription_one_live_per_user_course" ON "Subscription"("userId","courseId") WHERE "status" IN ('trialing','active')
model Subscription {
  id                  String             @id @default(uuid())
  userId              String
  communityId         String             @map("courseId")
  status              SubscriptionStatus
  priceCents          Int
  /// Chu kỳ: monthly (subscriptionPeriodDays) | annual (annualPeriodDays). priceCents = số tiền MỖI KỲ.
  interval            BillingInterval    @default(monthly)
  /// Thẻ lưu cho gia hạn / trừ tiền cuối kỳ dùng thử (null = dùng thử không thẻ, hết thử là hết quyền).
  paymentCardId       String?
  /// Đã gửi email nhắc trước ngày trừ tiền đầu tiên (claim idempotent).
  trialReminderSentAt DateTime?
  currentPeriodStart  DateTime
  currentPeriodEnd    DateTime
  cancelAtPeriodEnd   Boolean            @default(false)
  /// Có giá trị nếu gói bắt đầu bằng dùng thử (chặn dùng thử lần 2).
  trialEndsAt         DateTime?
  canceledAt          DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  community   Community    @relation(fields: [communityId], references: [id], onDelete: Restrict)
  paymentCard PaymentCard? @relation(fields: [paymentCardId], references: [id], onDelete: SetNull)

  payments Payment[]

  @@index([userId, communityId, createdAt])
  @@index([communityId])
  @@index([paymentCardId])
  @@index([status, currentPeriodEnd])
}

model RefundRequest {
  id              String       @id @default(uuid())
  paymentId       String
  communityId     String       @map("courseId")
  userId          String
  amountCents     Int
  reason          String       @default("")
  status          RefundStatus @default(pending)
  /// Hệ thống tự duyệt vì nằm trong cửa sổ hoàn tiền.
  auto            Boolean      @default(false)
  note            String?
  resolvedById    String?
  createdAt       DateTime     @default(now())
  resolvedAt      DateTime?
  /// Khóa idempotency gửi cổng khi hoàn tiền = id của yêu cầu này. Lưu mã hoàn của cổng sau khi cổng xác nhận.
  gatewayRefundId String?
  /// Thời điểm chuyển sang `refunding` (job đối soát tìm các yêu cầu kẹt quá lâu).
  refundingAt     DateTime?

  payment    Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  community  Community @relation(fields: [communityId], references: [id], onDelete: Restrict)
  user       User      @relation("RefundRequester", fields: [userId], references: [id], onDelete: Cascade)
  resolvedBy User?     @relation("RefundResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([paymentId, status])
  @@index([status, createdAt])
  @@index([communityId])
  @@index([userId])
  @@index([resolvedById])
}

/// Yêu cầu rút tiền của chủ cộng đồng. Chỉ lưu 4 số cuối tài khoản.
model Payout {
  id             String        @id @default(uuid())
  communityId    String        @map("courseId")
  ownerId        String
  amountCents    Int
  /// method.type luôn là 'bank' (chưa có kiểu khác) nên không có cột riêng.
  bankName       String
  accountHolder  String
  accountLast4   String
  status         PayoutStatus  @default(requested)
  note           String?
  /// Admin đợt 2: lý do thất bại; trạng thái trước khi bị giữ (để release trả lại).
  failureReason  String?
  heldFromStatus PayoutStatus?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  community Community @relation(fields: [communityId], references: [id], onDelete: Restrict)
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([communityId, status])
  @@index([status, createdAt])
  @@index([ownerId])
}

/// MÔ PHỎNG (Admin đợt 2): tranh chấp thẻ do bên phát hành mở. Không tích hợp cổng — chỉ là bản ghi phía admin để theo dõi/xử lý.
model Chargeback {
  id                  String           @id @default(uuid())
  /// Mã hiển thị CB-00771.
  caseNo              Int              @unique @default(autoincrement())
  paymentId           String
  communityId         String           @map("courseId")
  userId              String
  amountCents         Int
  reason              ChargebackReason
  status              ChargebackStatus @default(open)
  deadlineAt          DateTime
  evidenceNote        String?
  evidenceUrls        String[]         @default([])
  evidenceSubmittedAt DateTime?
  gatewayDisputeId    String?
  resolutionNote      String?
  resolvedById        String?
  openedAt            DateTime         @default(now())
  resolvedAt          DateTime?

  payment   Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  community Community @relation(fields: [communityId], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, deadlineAt])
  @@index([paymentId])
  @@index([communityId])
  @@index([userId])
}

/// Bộ đếm số hóa đơn theo năm. Tăng nguyên tử: UPDATE ... SET lastNumber = lastNumber + 1 RETURNING (upsert trong transaction).
model InvoiceSequence {
  year       Int @id
  lastNumber Int @default(0)
}

/// Khóa idempotency của tạo thanh toán: (user, Idempotency-Key) -> paymentId.
model IdempotencyKey {
  userId    String
  key       String
  paymentId String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key])
}

/// Giao dịch tiền VÀO từ ngân hàng (SePay webhook hoặc cron quét), ghi lại DÙ khớp hay không để admin soi tiền lạ.
/// `externalId` UNIQUE ⇒ webhook + quét thấy cùng 1 giao dịch chỉ tạo 1 dòng. Chỉ INSERT/đánh dấu credited — không xóa.
model BankTransaction {
  id              String    @id @default(uuid())
  externalId      String    @unique
  gateway         String?
  accountNumber   String?
  amount          Int
  description     String
  referenceCode   String?
  transactionDate DateTime
  matchedPaymentId String?
  credited        Boolean   @default(false)
  /// Lý do không khớp / ghi chú (thiếu tiền, phiên hết hạn, chuyển dư...).
  note            String?
  rawPayload      Json
  createdAt       DateTime  @default(now())

  @@index([credited, createdAt])
  @@index([matchedPaymentId])
}

/// Sổ cái nợ của Owner (append-only): ghi khi hoàn tiền/chargeback xảy ra SAU khi tiền đã được rút → số dư ròng âm. amountCents < 0 = nợ.
/// Số dư có thể rút = tiền đã qua cửa sổ hoàn tiền/tranh chấp, trừ reserve, trừ payout đã yêu cầu, trừ nợ; âm ⇒ chặn payout.
model OwnerBalanceLedger {
  id          String          @id @default(uuid())
  communityId String          @map("courseId")
  ownerId     String?
  kind        OwnerLedgerKind
  amountCents Int
  paymentId   String?
  refundId    String?
  note        String?
  createdAt   DateTime        @default(now())

  community Community @relation(fields: [communityId], references: [id], onDelete: Restrict)

  @@index([communityId, createdAt])
  @@index([ownerId])
}

// ============================================================================
// UPLOAD / HỖ TRỢ
// ============================================================================

/// Metadata file (file thật nằm ở storage). Hạn mức người dùng = SUM(size) theo ownerId.
model Upload {
  key         String        @id
  ownerId     String
  filename    String
  contentType String
  /// Byte. Ghi đè bằng dung lượng thật sau khi PUT xong.
  size        Int
  purpose     UploadPurpose
  communityId String?       @map("courseId")
  status      UploadStatus  @default(pending)
  /// Admin đợt 2: gắn cờ để xem xét / gỡ (file không còn được phục vụ công khai).
  flagged     Boolean       @default(false)
  flagReason  String?
  removedAt   DateTime?
  modReason   String?
  modAt       DateTime?
  modById     String?
  createdAt   DateTime      @default(now())

  owner     User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  community Community? @relation(fields: [communityId], references: [id], onDelete: SetNull)

  @@index([ownerId, createdAt])
  @@index([communityId])
}

model NewsletterSubscriber {
  id             String    @id @default(uuid())
  /// Chữ thường.
  email          String    @unique
  subscribedAt   DateTime  @default(now())
  /// Hủy đăng ký = đặt giá trị; đăng ký lại = đặt null.
  unsubscribedAt DateTime?
}

// ============================================================================
// DISCOVERY (Admin đợt 2)
// ============================================================================

/// Danh mục hiển thị ở Discovery: mỗi dòng ứng với 1 giá trị enum CourseCategory (khóa học hiện có không đổi). disabled = ẩn khỏi /categories.
model DiscoveryCategory {
  key         CourseCategory @id
  name        String
  description String?
  status      String         @default("active")
  position    Int
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

/// Ghim cộng đồng vào section Discovery (featured | trending | editors_picks | new_noteworthy), có thứ tự và khoảng hiệu lực.
model DiscoveryFeature {
  id          String    @id @default(uuid())
  section     String
  communityId String    @map("courseId")
  position    Int
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime  @default(now())
  createdById String?

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([section, communityId])
  @@index([section, position])
  @@index([communityId])
}

/// Cấu hình key-value của nền tảng (hiện dùng: `discovery.rankingWeights`).
model PlatformSetting {
  key         String   @id
  value       Json
  updatedAt   DateTime @updatedAt
  updatedById String?
}

/// ============================ Admin đợt 3 ============================
enum SupportCategory {
  user
  creator
  payment
}

enum SupportPriority {
  low
  medium
  high
  urgent
}

enum SupportTicketStatus {
  new
  open
  awaiting_reply
  resolved
  closed
}

enum SupportMessageKind {
  customer
  staff
  internal_note
  system
}

/// Ticket hỗ trợ (form liên hệ / người dùng tạo / admin tạo hộ). Mã hiển thị `T-${2000 + number}`.
model SupportTicket {
  id              String              @id @default(uuid())
  number          Int                 @unique @default(autoincrement())
  subject         String
  category        SupportCategory     @default(user)
  priority        SupportPriority     @default(medium)
  status          SupportTicketStatus @default(new)
  /// null = khách chưa có tài khoản (chỉ có email).
  requesterId     String?
  requesterName   String
  requesterEmail  String
  /// contact_form | user | admin | seed
  source          String              @default("user")
  assigneeId      String?
  escalated       Boolean             @default(false)
  escalatedAt     DateTime?
  firstResponseAt DateTime?
  resolvedAt      DateTime?
  closedAt        DateTime?
  lastActivityAt  DateTime            @default(now())
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  requester User?                  @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: SetNull)
  assignee  User?                  @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  messages  SupportTicketMessage[]

  @@index([status, lastActivityAt])
  @@index([category, status])
  @@index([assigneeId, status])
  @@index([requesterId])
  @@index([requesterEmail])
  @@index([createdAt])
}

model SupportTicketMessage {
  id         String             @id @default(uuid())
  ticketId   String
  kind       SupportMessageKind
  authorId   String?
  authorName String
  body       String
  createdAt  DateTime           @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

/// Vai trò nhân viên (hệ thống + tuỳ chỉnh). `key` là khóa; super_admin luôn đủ quyền (permissions chỉ để hiển thị).
model AdminRole {
  key         String   @id
  name        String
  description String   @default("")
  permissions String[] @default([])
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  accounts AdminAccount[]
}

/// Nhân viên admin ngoài danh sách env PLATFORM_ADMIN_EMAILS (những email đó luôn là Super Admin, không có hàng ở đây).
model AdminAccount {
  userId           String   @id
  roleKey          String
  /// active | suspended
  status           String   @default("active")
  /// Chỉ là cờ lưu trữ — chưa có 2FA thật.
  twoFactorEnabled Boolean  @default(false)
  suspendedReason  String?
  invitedById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User      @relation("AdminAccountUser", fields: [userId], references: [id], onDelete: Cascade)
  role AdminRole @relation(fields: [roleKey], references: [key], onDelete: Restrict)

  @@index([roleKey])
}

model FeatureFlag {
  key            String   @id
  name           String
  description    String   @default("")
  /// draft | beta | active
  stage          String   @default("draft")
  enabled        Boolean  @default(false)
  rolloutPercent Int      @default(100)
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Integration {
  key         String    @id
  name        String
  initials    String
  color       String    @default("#57534e")
  description String    @default("")
  category    String    @default("other")
  connected   Boolean   @default(false)
  /// Cấu hình KHÔNG nhạy cảm (account id, region...).
  config      Json      @default("{}")
  /// Chỉ 4 ký tự cuối của khóa (••••abcd); khóa thật không bao giờ được lưu.
  secretMask  String?
  connectedAt DateTime?
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model EmailTemplate {
  key         String   @id
  name        String
  description String   @default("")
  /// active | draft | disabled
  status      String   @default("draft")
  isSystem    Boolean  @default(false)
  variables   String[] @default([])
  /// { en: "...", vi: "..." }
  subject     Json
  body        Json
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Thông báo hệ thống gửi hàng loạt (audience: all | creators | paid_members | community | users).
model PlatformBroadcast {
  id             String   @id @default(uuid())
  title          String
  body           String
  link           String?
  audience       Json
  recipientCount Int
  emailCount     Int      @default(0)
  sentById       String?
  sentByName     String   @default("")
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

// ============================================================================
// WIZARD TẠO CỘNG ĐỒNG: thẻ, gói hosting owner, tài khoản nhận tiền
// ============================================================================

/// Thẻ thanh toán đã tokenize phía client. KHÔNG BAO GIỜ lưu số thẻ đầy đủ hay CVC: chỉ brand/last4/hạn + token cổng (mock `tok_mock_*`).
model PaymentCard {
  id           String   @id @default(uuid())
  userId       String
  gatewayToken String
  brand        String
  last4        String
  expMonth     Int
  expYear      Int
  createdAt    DateTime @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments      Payment[]
  subscriptions Subscription[]
  hostingPlans  HostingPlan[]

  @@unique([userId, gatewayToken])
  @@index([userId])
}

/// MÔ PHỎNG (A16 chưa chốt): gói hosting của owner cho 1 cộng đồng. Chưa có job/cổng trừ tiền khi hết dùng thử.
model HostingPlan {
  id             String            @id @default(uuid())
  communityId    String            @unique @map("courseId")
  ownerId        String
  planKey        HostingPlanKey
  cycle          BillingInterval   @default(monthly)
  /// Giá chụp lúc chọn (đơn vị nhỏ nhất của `currency`, VND không có phần thập phân).
  priceAmount    Int
  currency       String
  status         HostingPlanStatus
  trialStartedAt DateTime?
  trialEndsAt    DateTime?
  paymentCardId  String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  community   Community    @relation(fields: [communityId], references: [id], onDelete: Cascade)
  paymentCard PaymentCard? @relation(fields: [paymentCardId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@index([paymentCardId])
}

/// MÔ PHỎNG: tài khoản nhận tiền của cộng đồng (chỉ 4 số cuối). `skipped` = chưa kết nối (chặn rút tiền, cho phép publish).
model PayoutAccount {
  id            String              @id @default(uuid())
  communityId   String              @unique @map("courseId")
  ownerId       String
  status        PayoutAccountStatus
  bankName      String?
  accountHolder String?
  accountLast4  String?
  connectedAt   DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

// ============================================================================
// CHƯƠNG TRÌNH GIỚI THIỆU
// ============================================================================

enum ReferralKind {
  /// Người được giới thiệu mở cộng đồng (hoa hồng từ gói hosting của họ).
  creator
  /// Người được giới thiệu tham gia cộng đồng trả phí.
  member
}

enum CommissionStatus {
  pending
  paid
  void
}

/// Mã giới thiệu của mỗi user (link sofinhub.com/gioi-thieu/<code>).
model ReferralCode {
  userId    String   @id
  code      String   @unique
  createdAt DateTime @default(now())

  user User @relation("ReferralCodeOwner", fields: [userId], references: [id], onDelete: Cascade)
}

/// Ghi nhận 1 người đăng ký qua link giới thiệu (mỗi người chỉ được ghi nhận 1 lần). Hết hạn sau cửa sổ ghi nhận (Global Settings).
model Referral {
  id             String   @id @default(uuid())
  referrerId     String
  referredUserId String   @unique
  code           String
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  referrer     User @relation("ReferralReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUser User @relation("ReferralReferred", fields: [referredUserId], references: [id], onDelete: Cascade)

  @@index([referrerId, createdAt])
}

/// Hoa hồng phát sinh từ một khoản thanh toán của người được giới thiệu. sourceRef chống ghi nhận trùng ("payment:<id>", "hosting:<id>").
model ReferralCommission {
  id             String           @id @default(uuid())
  referrerId     String
  referredUserId String
  kind           ReferralKind
  communityId    String?
  sourceRef      String           @unique
  baseCents      Int
  rateBps        Int
  amountCents    Int
  status         CommissionStatus @default(pending)
  payoutOn       DateTime?
  createdAt      DateTime         @default(now())

  referrer     User @relation("CommissionReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUser User @relation("CommissionReferred", fields: [referredUserId], references: [id], onDelete: Cascade)

  @@index([referrerId, createdAt])
  @@index([referredUserId])
}
