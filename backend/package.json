{
  "name": "sofin_hub-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "dev:worker": "cross-env NODE_ENV=development tsx watch src/worker.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tools.json",
    "test": "cross-env NODE_ENV=test node --import tsx --test --test-concurrency=16 tests/*.test.ts",
    "test:coverage": "cross-env NODE_ENV=test c8 --reporter=text-summary --reporter=lcov --src=src --all --exclude=\"src/generated/**\" --exclude=\"tests/**\" node --import tsx --test --test-concurrency=16 tests/*.test.ts",
    "lint": "eslint -c ../eslint.config.mjs .",
    "postinstall": "prisma generate",
    "db:up": "docker compose -f ../docker-compose.yml up -d --wait",
    "db:down": "docker compose -f ../docker-compose.yml down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "cross-env NODE_ENV=development tsx prisma/seed.ts",
    "db:import-users": "cross-env NODE_ENV=development tsx prisma/import-users-json.ts",
    "db:reset": "prisma migrate reset --force && cross-env NODE_ENV=development tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.2",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.12.1",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "typescript": "^7.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "c8": "^12.0.0",
    "cross-env": "^10.1.0",
    "tsx": "^4.23.15"
  }
}
